# ============================================================
#  team85.cn 部署配置
# ============================================================
# 复制本文件为 .deploy.env 并填入真实值，.deploy.env 已加入 .gitignore。
#
#   cp scripts/.deploy.env.example scripts/.deploy.env
#
# 也可以把这里的变量 export 到 shell 配置里。
# ============================================================

# SSH 登录信息
DEPLOY_HOST="team85.cn"                 # 服务器域名或 IP
DEPLOY_PORT="22"                        # SSH 端口（默认 22）
DEPLOY_USER="root"                      # SSH 用户
DEPLOY_SSH_KEY="$HOME/.ssh/id_ed25519"  # SSH 私钥路径，留空则用默认

# 远端网站根目录
DEPLOY_PATH="/www/wwwroot/www.team85.cn"

# 本地工作区根目录（自动推断，无需改）
LOCAL_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# rsync 公共选项
# -a 归档模式（保留权限/时间/符号链接）
# -v 显示详情
# --progress  显示进度（仅 push 时开启，避免日志过长）
# --human-readable 人类可读尺寸
RSYNC_OPTS_COMMON=(-a --human-readable --delete)

# 远端 rsync 路径（一般留空，让 ssh 自己找）
RSYNC_REMOTE_SHELL=""

# ============================================================
# 排除规则：本地不会推送到服务器的路径
# ============================================================
EXCLUDES=(
  "--exclude=.git/"
  "--exclude=.gitignore"
  "--exclude=.DS_Store"
  "--exclude=node_modules/"
  "--exclude=_live_check/"           # 调试用快照目录
  "--exclude=.backup-*/"             # 本地备份目录（含 .backup-server-cruft/）
  "--exclude=.backups/"
  "--exclude=*.log"
  "--exclude=*.tmp"
  "--exclude=*.bak"
  "--exclude=.env"
  "--exclude=.env.*"
  "--exclude=.deploy.env"            # 部署配置不入库
  "--exclude=scripts/.deploy.env"
  # ↓ 开发/文档文件：Web 根目录不需要，且避免泄露部署结构
  "--exclude=scripts/"
  "--exclude=server.js"
  "--exclude=eslint.config.js"
  "--exclude=package.json"
  "--exclude=package-lock.json"
  "--exclude=README.md"
  "--exclude=.cursor/"
  "--exclude=*.example"
  "--exclude=data/interactions/"   # 访客互动运行时数据（服务器上 PHP 写入，rsync --delete 不得删）
  # ↓ 服务器 SSL 证书验证目录（acme-challenge 等），绝不能动
  "--exclude=.well-known/"
)