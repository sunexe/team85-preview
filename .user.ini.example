; ====================================================================
; 汕头一中八五足球队网站 - PHP 配置示例
; ====================================================================
; 在生产服务器上将此文件复制为 .user.ini 即可生效（PHP-FPM）。
; 主要约束 PHP 可访问的目录范围，提升安全性。
; ====================================================================

; 项目根目录限制 PHP 文件系统访问范围，防止跨站访问
; 请将 "/www/wwwroot/www.team85.cn/" 改为你的实际部署路径
open_basedir=/www/wwwroot/www.team85.cn/:/tmp/

; 上传文件大小限制（参考值，可调）
; upload_max_filesize = 10M
; post_max_size = 10M

; 时区设置
date.timezone = "Asia/Shanghai"
